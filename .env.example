# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql://traffic_user:traffic_pass@localhost:5432/traffic_db
# SQLite (Local Dev fallback):
DATABASE_URL=sqlite:///./traffic_system.db

# ==========================================
# Server Configuration
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ==========================================
# AI & Detection Configuration
# ==========================================
YOLO_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.45
TRACKER_TYPE=bytetrack
ENABLE_OCR=True
OCR_CONFIDENCE=0.40
OCR_LANGUAGE=en

# ==========================================
# Traffic Rules & Calibration Defaults
# ==========================================
DEFAULT_SPEED_LIMIT=60.0
SPEED_UNIT=km/h
ALLOWED_DIRECTION=down
RED_LIGHT_AUTOMATION=False
SIGNAL_CYCLE_SECONDS=15

# ==========================================
# Video Processing Source
# ==========================================
# Options: 'demo', 'webcam', 'rtsp://...', or path to mp4
DEFAULT_VIDEO_SOURCE=videos/sample_traffic.mp4
FPS_TARGET=30
SKIP_FRAMES=1
